  "keyFeatures": [
    "HTTP, FTP, BitTorrent, and magnet link downloads powered by a bundled aria2 engine",
    "Per-file selection for BitTorrent downloads with magnet link metadata resolution",
    "Built-in tracker list management with automatic updates and health checks",
    "QuickJS-based plugin sandbox with fine-grained permissions and in-app marketplace",
    "UPnP and NAT-PMP port mapping for improved peer connectivity",
    "Multiple speed-limit profiles with scheduling, adaptive, and video-app detection modes",
    "SQLite-backed download sessions that survive restarts",
    "Browser extensions for Chrome and Firefox (Manifest V3) with one-click hand-off",
    "Official @motrix/cli command-line client with MDXP JSON-RPC 2.0 protocol",
    "Docker headless server mode with Web UI for NAS and home-server deployments",
    "Dark mode, system tray integration, and launch at startup",
    "GeoIP database integration for peer location display"
  ],
  "publicApiSurface": [
    "MDXP protocol (JSON-RPC 2.0 over WebSocket and POST /mdxp)",
    "command:createDownload",
    "command:pauseTask / command:resumeTask / command:removeTask",
    "command:addTorrentTask / command:addMagnetTask",
    "command:updateSettings",
    "command:installPlugin / command:uninstallPlugin / command:enablePlugin / command:disablePlugin",
    "command:syncTrackers",
    "command:enableNat / command:disableNat",
    "event:taskUpdated / event:statsUpdated",
    "event:engineStateChanged / event:engineDisconnected",
    "event:pluginStatusChanged / event:pluginInstalled",
    "bridge:listPaired / bridge:revokePair / bridge:resolvePair",
    "@motrix/cli: motrix add, motrix list, motrix watch, motrix pair",
    "GET /healthz (Docker server health endpoint)",
    "motrix-admin pairing pending / approve / deny (Docker admin CLI)",
    "App settings schema (appSettingsSchema)",
